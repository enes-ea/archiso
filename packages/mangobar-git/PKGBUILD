# Maintainer: enes <enes@localhost>
# Fork of mangobar that shows the bar only while the modifier is held.
# Pinned to feat/show-on-mod.
pkgname=mangobar-enes-git
pkgver=r2.90066a1
pkgrel=1
pkgdesc="A simple bar for mango (enes-ea fork, show on modifier)"
url="https://github.com/enes-ea/mangobar"
arch=("x86_64")
license=("GPL-3.0")
depends=(
	cairo
	cjson
	tllist
	fcft
	gdk-pixbuf2
	libpulse
	pango
	pixman
	systemd-libs
	wayland
)
makedepends=(
	git
	meson
	ninja
	'wayland-protocols>=1.41'
)
provides=('mangobar')
conflicts=('mangobar' 'mangobar-git')
options=('!strip' '!lto')
source=("$pkgname::git+https://github.com/enes-ea/mangobar.git#commit=90066a1a926278f6f9f82d76261b8307bf0c1b9a")
md5sums=('SKIP')

pkgver() {
	cd "$pkgname"
	printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	export CC="gcc"
	arch-meson "$pkgname" build
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
